{
	"threshold": 1,
	"minLines": 8,
	"minTokens": 60,
	"reporters": ["console"],
	"gitignore": true,
	"ignore": [
		"**/node_modules/**",
		"**/dist/**",
		"**/coverage/**",
		"**/src-tauri/target/**",
		"**/src-tauri/gen/**",
		"**/components/ui/**",
		"**/*.test.ts",
		"**/*.test.tsx",
		"pnpm-lock.yaml"
	],
	"format": ["typescript", "tsx", "javascript", "css", "rust"]
}
