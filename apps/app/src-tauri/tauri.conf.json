{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "keyai",
	"version": "../../../package.json",
	"identifier": "io.github.mumpkin.keyai",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:1420",
		"beforeDevCommand": "pnpm dev:tauri-frontend",
		"beforeBuildCommand": "pnpm build:tauri-frontend"
	},
	"app": {
		"windows": [
			{
				"title": "keyai",
				"width": 1200,
				"height": 800,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"decorations": false,
				"fullscreen": false,
				"maximized": true
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["nsis", "appimage", "deb"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"category": "Education",
		"shortDescription": "Learn to read Japanese kana by typing them"
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2Q0YyNDQ3QTAxMEUxNjgKUldSbzRSQ2dSeVRQdHFuSnhXUUlocUxSdG05c3JZOCtsZ0xlV2FKU21DUkNDRndodDJiN3BXS3gK",
			"endpoints": [
				"https://github.com/mumpkin/keyai/releases/latest/download/latest.json"
			],
			"windows": { "installMode": "passive" }
		}
	}
}
