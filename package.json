{
	"name": "keyai",
	"version": "0.6.0",
	"private": true,
	"description": "Learn to read Japanese kana by typing them",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --filter @keyai/app dev",
		"dev:tauri": "pnpm --filter @keyai/app tauri dev",
		"build:web": "pnpm --filter @keyai/app build",
		"preview:web": "pnpm --filter @keyai/app preview --host",
		"build:tauri": "pnpm --filter @keyai/app tauri build",
		"check": "biome check .",
		"typecheck": "pnpm --recursive typecheck && tsc --project tools/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test --config apps/app/playwright.config.ts",
		"test:coverage": "vitest run --coverage",
		"duplicates": "jscpd",
		"prepare": "lefthook install",
		"vocab:fetch": "pnpm --filter @keyai/vocab fetch-sources",
		"vocab:build": "pnpm --filter @keyai/vocab build-vocabulary",
		"vocab:check": "pnpm --filter @keyai/vocab check-vocabulary"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "2.6.6",
		"@playwright/test": "^1.65.0",
		"@types/node": "^24.19.2",
		"@vitest/coverage-v8": "^5.1.0",
		"fast-check": "^4.10.2",
		"jscpd": "^5.4.2",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
