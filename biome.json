{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"root": true,
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 80,
		"lineEnding": "lf"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"jsxQuoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all",
			"arrowParentheses": "always"
		}
	},
	"css": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"yaml": {
		"formatter": {
			"indentWidth": 2
		}
	},
	"tailwind": {
		"mergeFunctions": ["clsx", "cn", "cva", "tw", "twMerge", "twJoin"]
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended",
			"tailwind": "recommended",
			"test": "recommended"
		},
		"rules": {
			"preset": "recommended",
			"nursery": {
				"useTailwindSortedClasses": {
					"level": "warn",
					"fix": "safe"
				}
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": {
						"maxAllowedComplexity": 10
					}
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 40,
						"skipBlankLines": true
					}
				},
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 3
					}
				}
			},
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 300,
						"skipBlankLines": true
					}
				},
				"noMagicNumbers": "error",
				"noNestedTernary": "error",
				"noParameterAssign": "error",
				"useBlockStatements": "error",
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": true,
						"requireAscii": true
					}
				}
			},
			"suspicious": {
				"noShadow": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"plugins": ["./tools/biome/no-single-letter-identifiers.grit"],
	"overrides": [
		{
			"includes": [
				"**/*.test.ts",
				"**/*.test.tsx",
				"**/*.spec.ts",
				"**/e2e/**"
			],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					},
					"style": {
						"noMagicNumbers": "off"
					}
				}
			}
		}
	]
}
